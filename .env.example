# Use "mock" for local UI testing or "supabase" for Supabase Auth.
AUTH_PROVIDER=mock
AUTH_MOCK_IDENTIFIER=
AUTH_MOCK_PASSWORD=
AUTH_MOCK_DISPLAY_NAME=Pengguna Uji
AUTH_SESSION_SECRET=

# Public origin used for strict same-origin and callback validation.
APP_ORIGIN=http://localhost:3000

# Required only when AUTH_PROVIDER=supabase. These names match the MBI project.
# Use the project URL and publishable/anon key. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PASSWORD_RESET_REDIRECT=http://localhost:3000/reset-kata-sandi

# Configure only after the Identity Provider is approved.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
